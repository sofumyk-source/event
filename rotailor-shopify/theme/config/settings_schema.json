[
  {
    "name": "theme_info",
    "theme_name": "RO Tailor Haberdashery",
    "theme_version": "1.0.0",
    "theme_author": "RO Tailor",
    "theme_documentation_url": "https://shopify.dev/docs/storefronts/themes",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "ブランド",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "ロゴ画像",
        "info": "未設定の場合は ROtailor のロゴ（テーマ内の画像）を表示します"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "ロゴの高さ",
        "min": 30,
        "max": 90,
        "step": 2,
        "unit": "px",
        "default": 48
      },
      {
        "type": "text",
        "id": "brand_name",
        "label": "ブランド名（ロゴ画像がない場合に表示）",
        "default": "ROtailor"
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "ブランドの添え書き",
        "default": "Hiroshima Custom Tailor — Est. 2019"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "ファビコン",
        "info": "32 × 32px 以上の正方形の画像"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "SNS 共有用の画像",
        "info": "ページに画像がないときに使われます（1200 × 628px 推奨）"
      }
    ]
  },
  {
    "name": "配色",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "背景色",
        "default": "#080808"
      },
      {
        "type": "color",
        "id": "color_deep",
        "label": "帯・フッターの背景色",
        "default": "#101010"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "カード・パネルの背景色",
        "default": "#161616"
      },
      {
        "type": "color",
        "id": "color_surface_2",
        "label": "画像の下地の色",
        "default": "#1E1E1E"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "文字色",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "補足テキストの色",
        "default": "#888880"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "罫線の色",
        "default": "#262624"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "ボタン・強調の色（ゴールド）",
        "default": "#C9A55A"
      },
      {
        "type": "color",
        "id": "color_on_primary",
        "label": "ボタン上の文字色",
        "default": "#080808"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "アクセントカラー（ゴールド）",
        "default": "#C9A55A"
      },
      {
        "type": "color",
        "id": "color_accent_light",
        "label": "アクセントカラー（明るいゴールド）",
        "default": "#E4C47A"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "セール価格の色",
        "default": "#D46A5A"
      }
    ]
  },
  {
    "name": "商品カード",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "画像の比率",
        "options": [
          {
            "value": "portrait",
            "label": "縦長（4:5）"
          },
          {
            "value": "square",
            "label": "正方形"
          },
          {
            "value": "natural",
            "label": "画像のまま"
          }
        ],
        "default": "portrait"
      },
      {
        "type": "checkbox",
        "id": "card_show_secondary_image",
        "label": "ホバー時に2枚目の画像を表示",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "ブランド（ベンダー）名を表示",
        "default": true
      }
    ]
  },
  {
    "name": "ご来店・ご予約",
    "settings": [
      {
        "type": "text",
        "id": "reservation_url",
        "label": "予約ボタンのリンク先",
        "default": "https://lin.ee/SaICq3So",
        "info": "LINE 公式アカウントや予約システムの URL https:// から始まる URL を入力してください"
      },
      {
        "type": "text",
        "id": "reservation_label",
        "label": "予約ボタンの文言",
        "default": "LINEで予約する"
      },
      {
        "type": "header",
        "content": "店舗 1"
      },
      {
        "type": "text",
        "id": "shop1_name",
        "label": "店舗名",
        "default": "ROtailor 袋町店"
      },
      {
        "type": "textarea",
        "id": "store_address",
        "label": "住所",
        "default": "広島市中区袋町8-14-1F"
      },
      {
        "type": "text",
        "id": "store_hours",
        "label": "営業時間・定休日",
        "default": "11:00〜19:00（毎週火曜定休）"
      },
      {
        "type": "text",
        "id": "store_phone",
        "label": "電話番号",
        "default": "082-205-3295"
      },
      {
        "type": "header",
        "content": "店舗 2（空欄なら非表示）"
      },
      {
        "type": "text",
        "id": "shop2_name",
        "label": "店舗名",
        "default": "ROtailor -laboratory-"
      },
      {
        "type": "textarea",
        "id": "shop2_address",
        "label": "住所",
        "default": "広島市西区西観音町8-2-1F"
      },
      {
        "type": "text",
        "id": "shop2_hours",
        "label": "営業時間・定休日",
        "default": "12:00〜18:00（毎週水・木曜定休）"
      },
      {
        "type": "text",
        "id": "shop2_phone",
        "label": "電話番号",
        "default": "050-5574-1819"
      }
    ]
  },
  {
    "name": "配送・カート",
    "settings": [
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "送料無料になる金額（円・税込）",
        "info": "0 にするとカートの「あと◯円で送料無料」を表示しません。実際の送料は［設定］→［配送］で設定してください",
        "default": 11000
      },
      {
        "type": "checkbox",
        "id": "cart_show_gift_note",
        "label": "カートにギフト包装の案内を表示",
        "default": true
      },
      {
        "type": "text",
        "id": "cart_gift_text",
        "label": "ギフト包装の案内文",
        "default": "ギフト包装（無料）をご希望の方は、備考欄にご記入ください。"
      }
    ]
  },
  {
    "name": "SNS",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram",
        "default": "https://www.instagram.com/rotailor77/"
      },
      {
        "type": "text",
        "id": "social_instagram2",
        "label": "Instagram（2つ目）",
        "default": "https://www.instagram.com/rotailor_laboratory_/"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok",
        "default": "https://www.tiktok.com/@rotailor"
      },
      {
        "type": "text",
        "id": "social_line",
        "label": "LINE 公式アカウント",
        "default": "https://lin.ee/SaICq3So",
        "info": "https:// から始まる URL を入力してください"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_x",
        "label": "X"
      }
    ]
  }
]
