{%- comment -%}
  Usage: {% render 'article-card', article: article, show_excerpt: true %}
{%- endcomment -%}
<article class="post-card">
  <a href="{{ article.url }}" class="post-card__media">
    {%- if article.image -%}
      {%- assign image_alt = article.image.alt | default: article.title | escape -%}
      {{
        article.image
        | image_url: width: 1000
        | image_tag:
          loading: 'lazy',
          widths: '400, 600, 800, 1000',
          sizes: '(min-width: 990px) 33vw, 100vw',
          alt: image_alt }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </a>
  <div class="post-card__body">
    <p class="post-card__meta">
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%Y.%m.%d' }}</time>
      {%- if article.tags.size > 0 -%}
        <span class="post-card__tag">{{ article.tags.first }}</span>
      {%- endif -%}
    </p>
    <h3 class="post-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
    {%- if show_excerpt -%}
      <p class="post-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 80 }}</p>
    {%- endif -%}
  </div>
</article>
