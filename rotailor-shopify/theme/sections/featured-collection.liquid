{%- assign collection = section.settings.collection -%}
<section class="section">
  <div class="container">
    <div class="section-head section-head--row">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section-title">{{ section.settings.heading | default: collection.title }}</h2>
      </div>
      {%- if collection != blank -%}
        <a href="{{ collection.url }}" class="link-arrow">{{ 'general.view_all' | t }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <div class="product-grid">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          {% render 'product-card-placeholder', index: i %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "おすすめ商品",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "小見出し", "default": "NEW ARRIVALS" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "新着アイテム" },
    { "type": "collection", "id": "collection", "label": "コレクション" },
    { "type": "range", "id": "limit", "label": "表示数", "min": 2, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "おすすめ商品" }]
}
{% endschema %}
