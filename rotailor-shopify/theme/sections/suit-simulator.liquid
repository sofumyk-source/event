{%- comment -%}
  オーダースーツ・シミュレーション
  ------------------------------------------------------------
  生地・スタイル・ディテールはすべて「ブロック」として
  テーマエディタから追加／編集できます（コード編集は不要）。
  ブロックの内容は JSON に変換され、assets/suit-simulator.js が描画します。
  価格は表示しません。お見積もりは店頭でご案内する導線にしています。
{%- endcomment -%}

{{ 'suit-simulator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'suit-stylist.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'suit-photo.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'suit-simulator.js' | asset_url }}" defer="defer"></script>

<section class="section simulator" id="Simulator-{{ section.id }}" data-suit-simulator data-section-id="{{ section.id }}">
  <div class="container">
    <div class="section-head simulator__head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="section-title">{{ section.settings.heading }}</h1>
      {%- if section.settings.intro != blank -%}<div class="section-intro rte">{{ section.settings.intro }}</div>{%- endif -%}
    </div>

    {%- if section.settings.show_stylist -%}
      {%- comment -%} ===== イメージから仕立てる（AI テイラー） ===== {%- endcomment -%}
      <div class="sim-stylist" data-stylist>
        <div class="sim-stylist__intro">
          <p class="eyebrow">TELL THE TAILOR</p>
          <h2 class="sim-stylist__title">{{ section.settings.stylist_heading }}</h2>
          <p class="sim-stylist__text">{{ section.settings.stylist_text }}</p>
        </div>
        <form class="sim-stylist__form" novalidate>
          <fieldset class="sim-stylist__field">
            <legend>好きな色<small>（3色まで）</small></legend>
            <div class="sim-stylist__colors" data-stylist-colors></div>
          </fieldset>
          <fieldset class="sim-stylist__field">
            <legend>着ていく場面<small>（いくつでも）</small></legend>
            <div class="sim-stylist__scenes" data-stylist-scenes></div>
          </fieldset>
          <div class="sim-stylist__field sim-stylist__photo-row">
            <span class="sim-stylist__label">参考写真<small>（任意）</small></span>
            <div class="sim-stylist__photo">
              <label class="sim-chip sim-stylist__photo-btn">
                写真を選ぶ
                <input type="file" accept="image/*" data-stylist-photo hidden>
              </label>
              <img class="sim-stylist__thumb" data-stylist-thumb alt="選んだ参考写真" width="56" height="56" hidden>
              <span class="sim-stylist__photo-colors" data-stylist-photo-colors aria-hidden="true"></span>
              <button type="button" class="sim-stylist__photo-remove" data-stylist-photo-remove hidden aria-label="参考写真を外す">×</button>
            </div>
            <p class="sim-stylist__hint">憧れのコーディネートや好きな景色の写真から、色や雰囲気を読み取ります。</p>
          </div>
          <label class="sim-stylist__field">
            <span class="sim-stylist__label">ひとこと<small>（任意）</small></span>
            <input type="text" class="sim-stylist__input" data-stylist-input maxlength="100" placeholder="{{ section.settings.stylist_placeholder }}">
          </label>
          <div class="sim-stylist__actions">
            <button type="submit" class="button button--accent">{{ section.settings.stylist_button }}</button>
            <p class="sim-stylist__progress" data-stylist-progress hidden aria-live="polite"></p>
          </div>
        </form>
      </div>
    {%- endif -%}

    <div class="simulator__layout">
      {%- comment -%} ===== プレビュー ===== {%- endcomment -%}
      <div class="simulator__stage">
        <div class="sim-preview">
          <button type="button" class="sim-chip sim-chip--shuffle" data-shuffle>おまかせ</button>
          <div class="sim-preview__toolbar" role="group" aria-label="表示の向き">
            <button type="button" class="sim-chip is-active" data-view="front" aria-pressed="true">FRONT</button>
            <button type="button" class="sim-chip" data-view="back" aria-pressed="false">BACK</button>
          </div>
          {%- if section.settings.photo_mode -%}
            <div class="sim-preview__toolbar sim-preview__toolbar--buttons" role="group" aria-label="ジャケットのボタン" data-open-toggle>
              <button type="button" class="sim-chip is-active" data-open="0" aria-pressed="true">ボタンを留める</button>
              <button type="button" class="sim-chip" data-open="1" aria-pressed="false">開ける</button>
            </div>
          {%- endif -%}
          <div class="sim-preview__canvas" data-preview aria-live="polite"></div>
          <div class="sim-preview__fabric" data-fabric-caption></div>
          <div class="sim-tryon" data-tryon>
            <label class="sim-chip sim-tryon__upload">
              自分の写真で試着する
              <input type="file" accept="image/*" data-tryon-file hidden>
            </label>
            <div class="sim-tryon__controls" data-tryon-controls hidden>
              <label class="sim-tryon__zoom">大きさ <input type="range" min="0.6" max="3.5" step="0.05" value="1.6" data-tryon-zoom></label>
              <button type="button" class="sim-tryon__remove" data-tryon-remove>写真を外す</button>
              <p class="sim-tryon__hint">顔をドラッグして位置を合わせてください</p>
            </div>
            <p class="sim-tryon__note">写真はこの画面の中だけで使われ、送信・保存はされません。</p>
          </div>
        </div>
        <div class="sim-total">
          <div class="sim-total__body">
            <p class="sim-total__label">YOUR STYLE</p>
            <p class="sim-total__chosen" data-chosen></p>
          </div>
          <button type="button" class="button button--primary sim-total__next" data-go-summary>仕上がりを見る</button>
        </div>
      </div>

      {%- comment -%} ===== 選択パネル ===== {%- endcomment -%}
      <div class="simulator__panel">
        <div class="sim-look" data-look hidden aria-live="polite"></div>
        <ol class="sim-steps" role="tablist" aria-label="シミュレーションの手順" data-steps-nav></ol>
        <div class="sim-step-body" data-step-body></div>
        <div class="sim-step-nav">
          <button type="button" class="button button--ghost" data-prev>戻る</button>
          <button type="button" class="button button--primary" data-next>次へ</button>
        </div>
      </div>
    </div>

    {%- comment -%} ===== 確認・ご予約 ===== {%- endcomment -%}
    <div class="sim-summary" data-summary hidden tabindex="-1">
      <div class="sim-summary__grid">
        <div class="sim-summary__spec">
          <p class="eyebrow">YOUR STYLE</p>
          <h2 class="section-title">{{ section.settings.summary_heading }}</h2>
          <div class="sim-summary__look">
            <div class="sim-summary__preview" data-summary-preview aria-hidden="true"></div>
            <dl class="sim-spec" data-spec></dl>
          </div>
          <div class="sim-summary__tools">
            <button type="button" class="button button--ghost" data-copy-link>この内容のリンクをコピー</button>
            <button type="button" class="button button--ghost" data-reset>最初からやり直す</button>
          </div>
        </div>

        <div class="sim-summary__actions">
          <div class="sim-estimate">
            <p class="eyebrow">ESTIMATE</p>
            <h3 class="sim-card__title">{{ section.settings.estimate_heading }}</h3>
            <p class="sim-card__text">{{ section.settings.estimate_text }}</p>
            {%- if settings.reservation_url != blank -%}
              <a href="{{ settings.reservation_url }}" class="button button--accent">{{ settings.reservation_label }}</a>
            {%- endif -%}
          </div>
          <div class="sim-card">
            <h3 class="sim-card__title">{{ section.settings.form_heading }}</h3>
            <p class="sim-card__text">{{ section.settings.form_text }}</p>
            {%- form 'contact', id: 'SimulatorForm', class: 'sim-form' -%}
              {%- if form.posted_successfully? -%}
                <p class="form-message form-message--success" role="status">{{ 'contact.success' | t }}</p>
              {%- endif -%}
              {%- if form.errors -%}
                <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
              {%- endif -%}
              <input type="hidden" name="contact[種別]" value="オーダースーツ シミュレーション">
              <textarea name="contact[シミュレーション内容]" data-form-spec hidden readonly></textarea>
              <label class="field">
                <span>{{ 'contact.name' | t }} <em>*</em></span>
                <input type="text" name="contact[name]" required autocomplete="name">
              </label>
              <label class="field">
                <span>{{ 'contact.email' | t }} <em>*</em></span>
                <input type="email" name="contact[email]" required autocomplete="email">
              </label>
              <label class="field">
                <span>{{ 'contact.phone' | t }}</span>
                <input type="tel" name="contact[phone]" autocomplete="tel">
              </label>
              <div class="field-row">
                <label class="field">
                  <span>ご来店希望日（第1希望）</span>
                  <input type="date" name="contact[来店希望日1]" data-min-today>
                </label>
                <label class="field">
                  <span>第2希望</span>
                  <input type="date" name="contact[来店希望日2]" data-min-today>
                </label>
              </div>
              <label class="field">
                <span>着用シーン・ご要望</span>
                <textarea name="contact[body]" rows="3" placeholder="例）秋の結婚式に。普段は 48 サイズの既製服を着ています。"></textarea>
              </label>
              <button type="submit" class="button button--primary button--block">{{ section.settings.form_button }}</button>
            {%- endform -%}
          </div>

        </div>
      </div>

      <div class="sim-pairing" data-pairing>
        <div class="section-head">
          <p class="eyebrow">TAILOR'S PAIRING</p>
          <h2 class="section-title">この一着に合わせたい小物</h2>
          <p class="section-intro" data-pairing-comment></p>
        </div>
        {%- for block in section.blocks -%}
          {%- if block.type == 'fabric' and block.settings.products.count > 0 -%}
            <div class="product-grid" data-pairing-for="{{ block.id }}" hidden>
              {%- for product in block.settings.products -%}
                {% render 'product-card', product: product %}
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if block.type == 'tie' and block.settings.product != blank -%}
            <div class="product-grid product-grid--single" data-tie-product-for="{{ block.id }}" hidden>
              {% render 'product-card', product: block.settings.product, note: 'プレビューで合わせたネクタイ' %}
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- for product in section.settings.tie_collection.products limit: 24 -%}
          <div class="product-grid product-grid--single" data-tie-product-for="p-{{ product.handle }}" hidden>
            {% render 'product-card', product: product, note: 'プレビューで合わせたネクタイ' %}
          </div>
        {%- endfor -%}
        {%- if section.settings.use_metaobjects -%}
          {%- for fabric in shop.metaobjects.suit_fabric.values -%}
            {%- assign mo_products = fabric.pairing_products.value -%}
            {%- if mo_products.count > 0 -%}
              <div class="product-grid" data-pairing-for="mo-{{ fabric.system.handle }}" hidden>
                {%- for product in mo_products -%}
                  {% render 'product-card', product: product %}
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if section.settings.fallback_products.count > 0 -%}
          <div class="product-grid" data-pairing-for="fallback" hidden>
            {%- for product in section.settings.fallback_products -%}
              {% render 'product-card', product: product %}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} ===== シミュレーション用データ（ブロックから生成） ===== {%- endcomment -%}
  <script type="application/json" data-simulator-config>
    {
      "threePieceEnabled": {{ section.settings.three_piece_enabled | json }},
      "stylistEndpoint": {{ section.settings.stylist_endpoint | json }},
      "storageKey": "rotailor-sim-{{ section.id }}",
      "photos": {%- if section.settings.photo_mode -%}{
        {%- assign photo_keys = 'sn-c,sn-o,sn-cv,sn-ov,sp-c,sp-o,sp-cv,sp-ov,dp-c,dp-cv' | split: ',' -%}
        {%- for key in photo_keys -%}
          {%- assign photo_file = 'suit-photo-' | append: key | append: '.jpg' -%}
          {%- assign mask_file = 'suit-photo-' | append: key | append: '-mask.png' -%}
          {{ key | json }}: { "photo": {{ photo_file | asset_url | json }}, "mask": {{ mask_file | asset_url | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      }{%- else -%}null{%- endif -%},
      "items": [
        {%- assign sep = '' -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign image_url = ''
            if block.settings.image != blank
              assign image_url = block.settings.image | image_url: width: 400
            endif
          -%}
          {{ sep }}{
            "id": {{ block.id | json }},
            "type": {{ block.type | json }},
            "name": {{ block.settings.name | json }},
            "description": {{ block.settings.description | json }},
            "key": {{ block.settings.key | json }},
            "color": "{{ block.settings.color }}",
            "pattern": {{ block.settings.pattern | json }},
            "patternColor": "{{ block.settings.pattern_color }}",
            "shirtColor": "{{ block.settings.shirt_color }}",
            "image": {{ image_url | json }},
            "mill": {{ block.settings.mill | json }},
            "origin": {{ block.settings.origin | json }},
            "composition": {{ block.settings.composition | json }},
            "season": {{ block.settings.season | json }},
            "comment": {{ block.settings.comment | json }},
            "width": {{ block.settings.width | default: 0 }},
            "needsText": {{ block.settings.needs_text | default: false | json }},
            "isDefault": {{ block.settings.is_default | default: false | json }}
          }
          {%- assign sep = ',' -%}
        {%- endfor -%}
        {%- if section.settings.use_metaobjects -%}
          {%- for fabric in shop.metaobjects.suit_fabric.values -%}
            {%- liquid
              assign image_url = ''
              if fabric.image.value != blank
                assign image_url = fabric.image.value | image_url: width: 400
              endif
              assign season = fabric.season.value | default: 'all'
              case season
                when '春夏'
                  assign season = 'ss'
                when '秋冬'
                  assign season = 'aw'
                when 'オールシーズン'
                  assign season = 'all'
              endcase
            -%}
            {{ sep }}{
              "id": {{ 'mo-' | append: fabric.system.handle | json }},
              "type": "fabric",
              "name": {{ fabric.name.value | json }},
              "color": "{{ fabric.color.value }}",
              "pattern": {{ fabric.pattern.value | default: 'solid' | json }},
              "patternColor": "{{ fabric.pattern_color.value }}",
              "image": {{ image_url | json }},
              "mill": {{ fabric.mill.value | json }},
              "origin": {{ fabric.origin.value | json }},
              "composition": {{ fabric.composition.value | json }},
              "season": {{ season | json }},
              "comment": {{ fabric.comment.value | json }},
              "isDefault": false
            }
            {%- assign sep = ',' -%}
          {%- endfor -%}
        {%- endif -%}
        {%- for product in section.settings.tie_collection.products limit: 24 -%}
          {%- if product.featured_image != blank -%}
            {{ sep }}{
              "id": {{ 'p-' | append: product.handle | json }},
              "type": "tie",
              "name": {{ product.title | remove: 'ROtailor×' | remove: 'ROtailor ' | json }},
              "description": {{ product.price | money | append: '（オンラインストアで購入できます）' | json }},
              "color": "",
              "pattern": "solid",
              "image": {{ product.featured_image | image_url: width: 600 | json }},
              "imageCrop": 0.12,
              "isProduct": true,
              "isDefault": false
            }
            {%- assign sep = ',' -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "オーダースーツ シミュレーション",
  "class": "section-suit-simulator",
  "max_blocks": 50,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "小見出し",
      "default": "MADE TO MEASURE SIMULATOR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "オーダースーツを仕立てる"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "導入文",
      "default": "<p>生地やラペル、ボタン、裏地まで。好きな組み合わせを選んで、あなただけの一着を思い描いてみてください。気に入ったイメージは、そのまま店頭でのご相談にお持ちいただけます。</p>"
    },
    {
      "type": "header",
      "content": "イメージから仕立てる（AI テイラー）"
    },
    {
      "type": "checkbox",
      "id": "show_stylist",
      "label": "入力欄を表示",
      "default": true
    },
    {
      "type": "text",
      "id": "stylist_endpoint",
      "label": "AI テイラーの API URL",
      "info": "stylist-api をデプロイした URL（末尾 /style まで）。空欄の場合は、サイト内蔵の言葉の辞書で仕立てます"
    },
    {
      "type": "text",
      "id": "stylist_heading",
      "label": "見出し",
      "default": "あなたの好みを、テイラーに。"
    },
    {
      "type": "textarea",
      "id": "stylist_text",
      "label": "説明",
      "default": "好きな色と、着ていく場面を選んでください。憧れのコーディネートや好きな景色の写真を添えると、その色や雰囲気も読み取って一着に仕立てます。"
    },
    {
      "type": "text",
      "id": "stylist_placeholder",
      "label": "ひとこと欄の例文",
      "default": "例）軽やかに見せたい、少し遊び心がほしい"
    },
    {
      "type": "text",
      "id": "stylist_button",
      "label": "ボタンの文言",
      "default": "テイラーに仕立ててもらう"
    },
    {
      "type": "checkbox",
      "id": "use_metaobjects",
      "label": "メタオブジェクト「suit_fabric」の生地も読み込む",
      "info": "生地が多い場合は、管理画面［コンテンツ］→［メタオブジェクト］で生地を管理できます（README 参照）",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "three_piece_enabled",
      "label": "スリーピース（ベスト）を選べるようにする",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "photo_mode",
      "label": "写真で着せ替える（正面）",
      "info": "マネキン写真の上で生地・シャツ・ネクタイを塗り替えます。オフにするとイラスト表示になります",
      "default": true
    },
    {
      "type": "collection",
      "id": "tie_collection",
      "label": "ネクタイの商品を選択肢に加える",
      "info": "選んだコレクションの商品写真から柄を作ります（最大 24 点）"
    },
    {
      "type": "header",
      "content": "仕上がり画面"
    },
    {
      "type": "text",
      "id": "summary_heading",
      "label": "見出し",
      "default": "あなたの一着が仕上がりました"
    },
    {
      "type": "text",
      "id": "estimate_heading",
      "label": "お見積もり案内の見出し",
      "default": "お見積もりは、店頭で。"
    },
    {
      "type": "textarea",
      "id": "estimate_text",
      "label": "お見積もり案内の文章",
      "default": "お仕立ての価格は、生地・仕立て方・サイズによって一着ずつ異なります。このイメージをお持ちいただければ、テイラーが実際の生地を手に取りながら、ご予算に合わせてご提案します。"
    },
    {
      "type": "header",
      "content": "来店予約フォーム"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "見出し",
      "default": "この内容でご来店予約"
    },
    {
      "type": "textarea",
      "id": "form_text",
      "label": "説明",
      "default": "選んだイメージはそのままテイラーに届きます。採寸・生地選び・お見積もりを含めて 60〜90 分ほどお時間をいただきます。"
    },
    {
      "type": "text",
      "id": "form_button",
      "label": "送信ボタンの文言",
      "default": "予約をリクエストする"
    },
    {
      "type": "header",
      "content": "小物の提案"
    },
    {
      "type": "product_list",
      "id": "fallback_products",
      "label": "生地ごとの提案がない場合に表示する商品",
      "limit": 8
    }
  ],
  "blocks": [
    {
      "type": "fabric",
      "name": "生地",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "生地名",
          "default": "ネイビー無地"
        },
        {
          "type": "text",
          "id": "mill",
          "label": "ブランド・ミル",
          "default": "Vitale Barberis Canonico"
        },
        {
          "type": "text",
          "id": "origin",
          "label": "産地",
          "default": "イタリア"
        },
        {
          "type": "text",
          "id": "composition",
          "label": "組成・目付",
          "default": "ウール 100%／260g"
        },
        {
          "type": "select",
          "id": "season",
          "label": "シーズン",
          "options": [
            {
              "value": "all",
              "label": "オールシーズン"
            },
            {
              "value": "ss",
              "label": "春夏"
            },
            {
              "value": "aw",
              "label": "秋冬"
            }
          ],
          "default": "all"
        },
        {
          "type": "color",
          "id": "color",
          "label": "生地の色",
          "default": "#1F2A44"
        },
        {
          "type": "select",
          "id": "pattern",
          "label": "柄",
          "options": [
            {
              "value": "solid",
              "label": "無地"
            },
            {
              "value": "pinstripe",
              "label": "ピンストライプ"
            },
