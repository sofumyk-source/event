{%- comment -%}
  「スーツの色から選ぶ小物」— テイラーならではのコーディネート提案。
  ブロック = スーツの色。色ごとに合わせ方の解説と、おすすめ商品を表示します。
{%- endcomment -%}
<section class="section suit-pairing" data-tabs>
  <div class="container">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.intro != blank -%}<div class="section-intro rte">{{ section.settings.intro }}</div>{%- endif -%}
    </div>

    <div class="suit-pairing__tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="suit-swatch-tab{% if forloop.first %} is-active{% endif %}"
          role="tab"
          id="PairingTab-{{ block.id }}"
          aria-controls="PairingPanel-{{ block.id }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          {{ block.shopify_attributes }}
        >
          <span class="suit-swatch" style="--swatch: {{ block.settings.swatch_color }};{% if block.settings.swatch_image %} background-image: url('{{ block.settings.swatch_image | image_url: width: 120 }}');{% endif %}"></span>
          <span>{{ block.settings.suit_name }}</span>
        </button>
      {%- endfor -%}
    </div>

    {%- for block in section.blocks -%}
      <div
        class="suit-pairing__panel"
        role="tabpanel"
        id="PairingPanel-{{ block.id }}"
        aria-labelledby="PairingTab-{{ block.id }}"
        {% unless forloop.first %}hidden{% endunless %}
      >
        <div class="suit-pairing__advice">
          <p class="eyebrow">TAILOR'S RULE</p>
          <h3 class="suit-pairing__title">{{ block.settings.title }}</h3>
          <div class="rte">{{ block.settings.advice }}</div>
          <dl class="pairing-rules">
            {%- if block.settings.rule_tie != blank -%}<div><dt>Tie</dt><dd>{{ block.settings.rule_tie }}</dd></div>{%- endif -%}
            {%- if block.settings.rule_shoes != blank -%}<div><dt>Shoes</dt><dd>{{ block.settings.rule_shoes }}</dd></div>{%- endif -%}
            {%- if block.settings.rule_bag != blank -%}<div><dt>Bag &amp; Belt</dt><dd>{{ block.settings.rule_bag }}</dd></div>{%- endif -%}
          </dl>
          {%- if block.settings.collection != blank -%}
            <a href="{{ block.settings.collection.url }}" class="link-arrow">{{ block.settings.suit_name }}に合う小物をすべて見る {% render 'icon', name: 'arrow' %}</a>
          {%- endif -%}
        </div>
        <div class="product-grid product-grid--3">
          {%- if block.settings.products.count > 0 -%}
            {%- for product in block.settings.products -%}
              {% render 'product-card', product: product %}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..3) -%}
              {% render 'product-card-placeholder', index: i %}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "スーツの色から選ぶ小物",
  "class": "section-suit-pairing",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "小見出し", "default": "PAIRING GUIDE" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "スーツの色から選ぶ小物" },
    {
      "type": "richtext",
      "id": "intro",
      "label": "導入文",
      "default": "<p>お手持ちのスーツの色を選んでください。テイラーが普段フィッティングでお伝えしている合わせ方と、おすすめのアイテムをご紹介します。</p>"
    }
  ],
  "blocks": [
    {
      "type": "suit",
      "name": "スーツの色",
      "settings": [
        { "type": "text", "id": "suit_name", "label": "スーツの色名", "default": "ネイビー" },
        { "type": "color", "id": "swatch_color", "label": "見本の色", "default": "#1F2A44" },
        { "type": "image_picker", "id": "swatch_image", "label": "見本の生地画像（任意）" },
        { "type": "text", "id": "title", "label": "提案の見出し", "default": "まず一着目のネイビーには、ボルドーと焦げ茶を。" },
        { "type": "richtext", "id": "advice", "label": "テイラーの解説", "default": "<p>ネイビーは最も合わせやすい色ですが、だからこそ小物で差が出ます。</p>" },
        { "type": "text", "id": "rule_tie", "label": "ネクタイの合わせ方", "default": "ボルドーの小紋、ネイビーのソリッド" },
        { "type": "text", "id": "rule_shoes", "label": "靴の合わせ方", "default": "ダークブラウンのストレートチップ" },
        { "type": "text", "id": "rule_bag", "label": "バッグ・ベルトの合わせ方", "default": "靴と同じ茶系で揃える" },
        { "type": "product_list", "id": "products", "label": "おすすめ商品", "limit": 6 },
        { "type": "collection", "id": "collection", "label": "「すべて見る」のリンク先" }
      ]
    }
  ],
  "presets": [
    {
      "name": "スーツの色から選ぶ小物",
      "blocks": [
        {
          "type": "suit",
          "settings": {
            "suit_name": "ネイビー",
            "swatch_color": "#1F2A44",
            "title": "一着目のネイビーには、ボルドーと焦げ茶を。",
            "rule_tie": "ボルドーの小紋、ネイビーのソリッド",
            "rule_shoes": "ダークブラウンのストレートチップ",
            "rule_bag": "靴と同じ茶系で揃える"
          }
        },
        {
          "type": "suit",
          "settings": {
            "suit_name": "チャコールグレー",
            "swatch_color": "#3B3D40",
            "title": "チャコールには、黒の靴と銀鼠のネクタイで端正に。",
            "rule_tie": "シルバーグレー、深いグリーン",
            "rule_shoes": "ブラックのキャップトゥ",
            "rule_bag": "黒のブリーフケースで引き締める"
          }
        },
        {
          "type": "suit",
          "settings": {
            "suit_name": "ブラウン",
            "swatch_color": "#5A4232",
            "title": "ブラウンのスーツは、同系色でまとめて上品に。",
            "rule_tie": "オリーブ、マスタードのニットタイ",
            "rule_shoes": "スエードのダークブラウン",
            "rule_bag": "ヌメ革やタンの小物で軽さを出す"
          }
        }
      ]
    }
  ]
}
{% endschema %}
