{%- assign blog = section.settings.blog -%}
<section class="section">
  <div class="container">
    <div class="section-head section-head--row">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="section-title">{{ section.settings.heading }}</h2>
      </div>
      {%- if blog != blank -%}
        <a href="{{ blog.url }}" class="link-arrow">{{ 'blogs.all_posts' | t }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <div class="post-grid">
      {%- if blog != blank and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: section.settings.limit -%}
          {% render 'article-card', article: article, show_excerpt: section.settings.show_excerpt %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="post-card">
            <div class="post-card__media">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}</div>
            <div class="post-card__body">
              <p class="post-card__meta"><span>2026.10.01</span><span class="post-card__tag">着こなし</span></p>
              <h3 class="post-card__title">ブログ記事のタイトル</h3>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ブログ記事",
  "class": "section-blog-posts",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "小見出し", "default": "JOURNAL" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "テイラーの手帖" },
    { "type": "blog", "id": "blog", "label": "ブログ" },
    { "type": "range", "id": "limit", "label": "表示数", "min": 2, "max": 9, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_excerpt", "label": "抜粋を表示", "default": true }
  ],
  "presets": [{ "name": "ブログ記事" }]
}
{% endschema %}
