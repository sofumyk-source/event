{%- if section.blocks.size > 0 -%}
  <div class="announcement" {{ section.shopify_attributes }}>
    <div class="announcement__track" data-rotator>
      {%- for block in section.blocks -%}
        <p class="announcement__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "お知らせバー",
  "class": "section-announcement",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "message",
      "name": "メッセージ",
      "settings": [
        { "type": "text", "id": "text", "label": "テキスト", "default": "税込 11,000円以上のご購入で送料無料" },
        { "type": "url", "id": "link", "label": "リンク" }
      ]
    }
  ],
  "presets": [
    {
      "name": "お知らせバー",
      "blocks": [
        { "type": "message" }
      ]
    }
  ]
}
{% endschema %}
