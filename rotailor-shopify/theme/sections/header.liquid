<header class="site-header{% if section.settings.sticky %} site-header--sticky{% endif %}" data-header>
  <div class="site-header__inner container">
    <details class="drawer" data-drawer>
      <summary class="icon-button drawer__toggle" aria-label="{{ 'general.menu' | t }}">
        <span class="drawer__open">{% render 'icon', name: 'menu' %}</span>
        <span class="drawer__close">{% render 'icon', name: 'close' %}</span>
      </summary>
      <div class="drawer__panel">
        <nav aria-label="{{ 'general.menu' | t }}">
          <ul class="drawer__menu">
            {%- for link in section.settings.menu.links -%}
              {%- comment -%} 商品がまだないカテゴリー（追加準備中のカフス・Tシャツなど）は、商品が入るまで出さない {%- endcomment -%}
              {%- if link.type == 'collection_link' and link.object.products_count == 0 -%}{%- continue -%}{%- endif -%}
              <li>
                <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
                {%- if link.links.size > 0 -%}
                  <ul class="drawer__submenu">
                    {%- for child in link.links -%}
                      <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
        {%- if settings.reservation_url != blank -%}
          <a href="{{ settings.reservation_url }}" class="button button--primary drawer__cta">{{ settings.reservation_label }}</a>
        {%- endif -%}
        {% render 'social-links' %}
      </div>
    </details>

    <a href="{{ routes.root_url }}" class="site-logo" aria-label="{{ shop.name }}">
      {%- if settings.logo -%}
        {{
          settings.logo
          | image_url: height: 160
          | image_tag: alt: shop.name, class: 'site-logo__img', loading: 'eager'
        }}
      {%- else -%}
        <img src="{{ 'ro-logo.jpg' | asset_url }}" alt="{{ shop.name }}" class="site-logo__img" width="542" height="709" loading="eager">
      {%- endif -%}
      {%- if settings.brand_tagline != blank -%}
        <span class="site-logo__tagline">{{ settings.brand_tagline }}</span>
      {%- endif -%}
    </a>

    <nav class="site-nav" aria-label="{{ 'general.menu' | t }}">
      <ul class="site-nav__list">
        {%- for link in section.settings.menu.links -%}
          {%- comment -%} 商品がまだないカテゴリー（追加準備中のカフス・Tシャツなど）は、商品が入るまで出さない {%- endcomment -%}
          {%- if link.type == 'collection_link' and link.object.products_count == 0 -%}{%- continue -%}{%- endif -%}
          <li class="site-nav__item{% if link.links.size > 0 %} has-children{% endif %}">
            <a href="{{ link.url }}" class="site-nav__link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- if link.links.size > 0 -%}
              <ul class="site-nav__dropdown">
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__actions">
      {%- if section.settings.show_line_link and settings.reservation_url != blank -%}
        <a href="{{ settings.reservation_url }}" class="header-line" target="_blank" rel="noopener">
          {% render 'icon', name: 'line' %}
          <span>{{ section.settings.line_label }}</span>
        </a>
      {%- endif -%}
      {%- if section.settings.show_simulator_link and section.settings.simulator_page != blank -%}
        <a href="{{ section.settings.simulator_page.url }}" class="header-pill">
          {% render 'icon', name: 'needle' %}
          <span>{{ section.settings.simulator_label }}</span>
        </a>
      {%- endif -%}
      <a href="{{ routes.search_url }}" class="icon-button" aria-label="{{ 'general.search' | t }}" data-search-open>{% render 'icon', name: 'search' %}</a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="icon-button icon-button--desktop" aria-label="{{ 'general.account' | t }}">{% render 'icon', name: 'account' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="icon-button cart-link" aria-label="{{ 'general.cart' | t }}">
        {% render 'icon', name: 'cart' %}
        <span class="cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %} aria-label="{{ 'accessibility.cart_count' | t }}">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<dialog class="search-modal" data-search-dialog aria-label="{{ 'general.search' | t }}">
  <div class="search-modal__inner container">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-modal__form">
      {% render 'icon', name: 'search' %}
      <input
        type="search"
        name="q"
        placeholder="{{ 'search.placeholder' | t }}"
        aria-label="{{ 'search.placeholder' | t }}"
        autocomplete="off"
        data-search-input
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button type="button" class="icon-button" data-dialog-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </form>
    <div class="search-modal__results" data-search-results aria-live="polite"></div>
    {%- if section.settings.search_suggestions != blank -%}
      <div class="search-modal__popular">
        <p class="eyebrow">POPULAR</p>
        <div class="filter-chips">
          {%- assign words = section.settings.search_suggestions | split: ',' -%}
          {%- for word in words -%}
            <a href="{{ routes.search_url }}?q={{ word | strip | url_encode }}">{{ word | strip }}</a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</dialog>

{% schema %}
{
  "name": "ヘッダー",
  "class": "section-header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "メニュー", "default": "main-menu" },
    { "type": "checkbox", "id": "sticky", "label": "スクロール時に固定", "default": true },
    { "type": "text", "id": "search_suggestions", "label": "検索画面のおすすめキーワード（カンマ区切り）", "default": "ネクタイ,CERRUTI,セミブローグ,トートバッグ,手染め" },
    { "type": "header", "content": "スーツシミュレーションへのリンク" },
    { "type": "checkbox", "id": "show_simulator_link", "label": "ヘッダーに表示", "default": true },
    { "type": "page", "id": "simulator_page", "label": "シミュレーションのページ", "info": "テンプレート「page.simulator」を割り当てたページを選択" },
    { "type": "text", "id": "simulator_label", "label": "表示名", "default": "スーツを仕立てる" },
    { "type": "header", "content": "LINE予約ボタン" },
    { "type": "checkbox", "id": "show_line_link", "label": "ヘッダーに表示", "default": true, "info": "リンク先はテーマ設定「ご来店・ご予約」の予約ボタンのリンク先" },
    { "type": "text", "id": "line_label", "label": "表示名", "default": "LINE予約" }
  ]
}
{% endschema %}
