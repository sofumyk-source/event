<div class="container">
  <header class="page-header">
    <p class="eyebrow">CATEGORIES</p>
    <h1 class="section-title">{{ section.settings.heading }}</h1>
  </header>
  <div class="category-grid page-body">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="category-tile">
        <div class="category-tile__media">
          {%- if collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw' }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </div>
        <div class="category-tile__label">
          <span class="category-tile__ja">{{ collection.title }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "コレクション一覧",
  "class": "section-main-list-collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "すべてのカテゴリ" }
  ]
}
{% endschema %}
