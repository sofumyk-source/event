<section class="section simulator-promo">
  <div class="container simulator-promo__grid">
    <div class="simulator-promo__body">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--light">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section-title section-title--light">{{ section.settings.heading | newline_to_br }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      <ul class="simulator-promo__steps">
        <li><span>01</span>{{ section.settings.step_1 }}</li>
        <li><span>02</span>{{ section.settings.step_2 }}</li>
        <li><span>03</span>{{ section.settings.step_3 }}</li>
      </ul>
      <a href="{{ section.settings.page.url | default: '#' }}" class="button button--light">{{ section.settings.button_label }}</a>
    </div>
    <a class="simulator-promo__visual" href="{{ section.settings.page.url | default: '#' }}" aria-label="{{ section.settings.button_label | escape }}">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 800, 1000', sizes: '(min-width: 990px) 40vw, 100vw' }}
      {%- else -%}
        {%- comment -%} シミュレーターで実際に仕立てた一着の「表紙」を 3 枚、扇のように重ねる {%- endcomment -%}
        <span class="promo-covers">
          {%- for i in (1..3) -%}
            {%- assign cover = 'promo-cover-' | append: i | append: '.jpg' -%}
            <img class="promo-covers__card promo-covers__card--{{ i }}" src="{{ cover | asset_url }}" alt="" width="1080" height="1440" loading="lazy">
          {%- endfor -%}
        </span>
      {%- endif -%}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "シミュレーション案内",
  "class": "section-simulator-promo",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "小見出し", "default": "MADE TO MEASURE" },
    { "type": "textarea", "id": "heading", "label": "見出し", "default": "あなたの一着を、\nまずは画面の上で。" },
    {
      "type": "richtext",
      "id": "text",
      "label": "本文",
      "default": "<p>生地、ラペル、ボタン、裏地まで。好きな組み合わせを選ぶと、イラストの一着がその場で着替えます。思い描いたイメージは、そのまま店頭でのご相談に。</p>"
    },
    { "type": "page", "id": "page", "label": "シミュレーションのページ" },
    { "type": "text", "id": "button_label", "label": "ボタンの文言", "default": "一着を仕立ててみる" },
    { "type": "text", "id": "step_1", "label": "手順 1", "default": "好きな色と、着ていく場面を伝える" },
    { "type": "text", "id": "step_2", "label": "手順 2", "default": "生地・型・シャツ・ネクタイ・靴まで着せ替える" },
    { "type": "text", "id": "step_3", "label": "手順 3", "default": "仕上がりの一枚を保存して、店頭へ" },
    { "type": "image_picker", "id": "image", "label": "画像（未設定ならシミュレーターの仕上がり例）" }
  ],
  "presets": [{ "name": "シミュレーション案内" }]
}
{% endschema %}
