{%- comment -%}
  トップページの「オーダースーツ・シミュレーター」案内。
  入口は 2 つ：テイラーにおまかせで一着仕立ててもらう（#start-tailor）／手持ちの小物に合わせてみる（#start-vzone）。
  どちらもシミュレーターのページの該当箇所から始まります（assets/suit-simulator.js の deepLink）。
{%- endcomment -%}
{%- assign sim_url = section.settings.page.url | default: '#' -%}
<section class="section simulator-promo">
  <div class="container simulator-promo__grid">
    <div class="simulator-promo__body">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--light">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="simulator-promo__name">{{ section.settings.name }}</h2>
      <p class="simulator-promo__catch">{{ section.settings.heading | newline_to_br }}</p>
      <div class="rte simulator-promo__text">{{ section.settings.text }}</div>

      <div class="simulator-promo__doors">
        <a class="promo-door" href="{{ sim_url }}#start-tailor">
          <span class="promo-door__label">{{ section.settings.door_1_label }}</span>
          <span class="promo-door__title">{{ section.settings.door_1_title }}</span>
          <span class="promo-door__text">{{ section.settings.door_1_text }}</span>
          <span class="promo-door__go" aria-hidden="true">{% render 'icon', name: 'arrow' %}</span>
        </a>
        <a class="promo-door" href="{{ sim_url }}#start-vzone">
          <span class="promo-door__label">{{ section.settings.door_2_label }}</span>
          <span class="promo-door__title">{{ section.settings.door_2_title }}</span>
          <span class="promo-door__text">{{ section.settings.door_2_text }}</span>
          <span class="promo-door__go" aria-hidden="true">{% render 'icon', name: 'arrow' %}</span>
        </a>
      </div>

      <div class="simulator-promo__cta">
        <a href="{{ sim_url }}" class="button button--accent">{{ section.settings.button_label }}</a>
        {%- if section.settings.note != blank -%}<p class="simulator-promo__note">{{ section.settings.note }}</p>{%- endif -%}
      </div>
    </div>

    <a class="simulator-promo__visual" href="{{ sim_url }}" aria-label="{{ section.settings.name | escape }}を開く">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 800, 1000', sizes: '(min-width: 990px) 40vw, 100vw' }}
      {%- else -%}
        {%- comment -%} シミュレーターで実際に仕立てた一着の「表紙」を 3 枚、扇のように重ねる {%- endcomment -%}
        <span class="promo-covers">
          {%- for i in (1..3) -%}
            {%- assign cover = 'promo-cover-' | append: i | append: '.jpg' -%}
            <img class="promo-covers__card promo-covers__card--{{ i }}" src="{{ cover | asset_url }}" alt="" width="1080" height="1440" loading="lazy">
          {%- endfor -%}
        </span>
      {%- endif -%}
      <span class="simulator-promo__caption">{{ section.settings.caption }}</span>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "シミュレーション案内",
  "class": "section-simulator-promo",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "小見出し", "default": "Order Simulator" },
    { "type": "text", "id": "name", "label": "名称", "default": "オーダースーツ・シミュレーター" },
    { "type": "textarea", "id": "heading", "label": "キャッチ", "default": "生地も、型も、靴との相性も。\n画面の上で、自由に仕立ててみる。" },
    {
      "type": "richtext",
      "id": "text",
      "label": "本文",
      "default": "<p>オーダースーツは、選べることがいちばんの楽しみです。気になる生地で一着つくってみたり、お持ちのネクタイや靴と合わせてみたり。遊ぶ感覚で、オーダーの面白さに触れてください。</p>"
    },
    { "type": "page", "id": "page", "label": "シミュレーションのページ" },
    { "type": "header", "content": "入口 1：おまかせ" },
    { "type": "text", "id": "door_1_label", "label": "ラベル", "default": "はじめての方に" },
    { "type": "text", "id": "door_1_title", "label": "見出し", "default": "テイラーにおまかせで、一着仕立ててもらう" },
    { "type": "text", "id": "door_1_text", "label": "説明", "default": "好きな色と着ていく場面を選ぶだけ。あなたのための一着が仕上がります。" },
    { "type": "header", "content": "入口 2：手持ちに合わせる" },
    { "type": "text", "id": "door_2_label", "label": "ラベル", "default": "コーディネートに迷ったら" },
    { "type": "text", "id": "door_2_title", "label": "見出し", "default": "お持ちのネクタイ・靴に合わせてみる" },
    { "type": "text", "id": "door_2_text", "label": "説明", "default": "ネクタイやシャツは写真から、靴は色から。今あるアイテムとの相性を確かめられます。" },
    { "type": "header", "content": "ボタン・画像" },
    { "type": "text", "id": "button_label", "label": "ボタンの文言", "default": "シミュレーターを試してみる" },
    { "type": "text", "id": "note", "label": "ボタン下の注記", "default": "無料・会員登録なし・約1分" },
    { "type": "text", "id": "caption", "label": "画像の下の一言", "default": "シミュレーターで仕立てた一着の例" },
    { "type": "image_picker", "id": "image", "label": "画像（未設定ならシミュレーターの仕上がり例）" }
  ],
  "presets": [{ "name": "シミュレーション案内" }]
}
{% endschema %}
