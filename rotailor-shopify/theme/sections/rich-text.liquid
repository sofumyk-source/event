<section class="section" style="--section-bg: {{ section.settings.background }};">
  <div class="container container--narrow" style="text-align: {{ section.settings.alignment }};">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="rte">{{ section.settings.text }}</div>
    {%- if section.settings.button_label != blank -%}
      <p style="margin-top: 32px;"><a href="{{ section.settings.button_link | default: '#' }}" class="button">{{ section.settings.button_label }}</a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "テキスト",
  "class": "section-rich-text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "小見出し" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "見出し" },
    { "type": "richtext", "id": "text", "label": "本文", "default": "<p>本文を入力してください。</p>" },
    {
      "type": "select",
      "id": "alignment",
      "label": "配置",
      "options": [
        { "value": "left", "label": "左寄せ" },
        { "value": "center", "label": "中央" }
      ],
      "default": "center"
    },
    { "type": "color", "id": "background", "label": "背景色" },
    { "type": "text", "id": "button_label", "label": "ボタンの文言" },
    { "type": "url", "id": "button_link", "label": "ボタンのリンク" }
  ],
  "presets": [{ "name": "テキスト" }]
}
{% endschema %}
