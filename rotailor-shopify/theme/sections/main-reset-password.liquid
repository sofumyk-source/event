<div class="container account-page">
  <div class="account-card">
    <h1 class="section-title">パスワードの再設定</h1>
    {%- form 'reset_customer_password', class: 'sim-form' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label class="field"><span>新しいパスワード</span><input type="password" name="customer[password]" autocomplete="new-password" required></label>
      <label class="field"><span>新しいパスワード（確認）</span><input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
      <button type="submit" class="button button--primary button--block">設定する</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "パスワード再設定", "class": "section-main-reset-password" }
{% endschema %}
